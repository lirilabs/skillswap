<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    
    <!-- OpenGraph Meta Tags for WhatsApp/iMessage previews -->
    <meta property="og:title" content="<%= title %>" />
    <meta property="og:description" content="<%= description %>" />
    <meta property="og:image" content="<%= image %>" />
    <meta property="og:url" content="<%= url %>" />
    <meta property="og:type" content="website" />

    <!-- Twitter Card data -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= title %>">
    <meta name="twitter:description" content="<%= description %>">
    <meta name="twitter:image" content="<%= image %>">

    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #0f0f0f;
            color: white;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            text-align: center;
            padding: 20px;
        }
        .container {
            background: #1a1a1a;
            padding: 40px;
            border-radius: 24px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            max-width: 400px;
        }
        h1 { color: #FE7B5F; font-size: 24px; margin-bottom: 8px; }
        p { color: #888; font-size: 14px; margin-bottom: 24px; line-height: 1.5; }
        .btn {
            background-color: #FE7B5F;
            color: #fff;
            padding: 14px 28px;
            text-decoration: none;
            border-radius: 12px;
            font-weight: bold;
            display: inline-block;
            transition: opacity 0.2s;
        }
        .btn:active { opacity: 0.8; }
        .loader {
            border: 3px solid rgba(254, 123, 95, 0.2);
            border-top: 3px solid #FE7B5F;
            border-radius: 50%;
            width: 30px;
            height: 30px;
            animation: spin 1s linear infinite;
            margin: 0 auto 20px auto;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
</head>
<body>
    <div class="container">
        <div class="loader"></div>
        <h1>Opening SkillSwap...</h1>
        <p>If you have the SkillSwap app installed, you will be redirected automatically within a few seconds.</p>
        
        <!-- Fallback button if auto-redirect fails -->
        <a id="manualBtn" href="<%= appLink %>" class="btn">Open SkillSwap</a>
    </div>

    <script>
        // Forceful Deep Link Transfer Bypassing Web
        window.onload = function() {
            var isAndroid = /Android/i.test(navigator.userAgent);
            var isIOS = /iPhone|iPad|iPod/i.test(navigator.userAgent);
            var appLink = "<%= appLink %>"; // e.g. skillswap://profile/123

            if (isAndroid) {
                // Force Android to bypass Chrome and open the App directly via Package Intent
                var intentPath = appLink.replace("skillswap://", "");
                var intentUrl = "intent://" + intentPath + "#Intent;scheme=skillswap;package=com.sas.skillswap;end";
                
                // Update manual button just in case
                document.getElementById('manualBtn').href = intentUrl;
                
                window.location.href = intentUrl;
            } else if (isIOS) {
                // iOS Universal Link Fallback
                window.location.href = appLink;
            } else {
                // Desktop / other
                setTimeout(function() {
                    window.location.href = appLink;
                }, 500);
            }
        };
    </script>
</body>
</html>
